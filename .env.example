# ==============================================================================
# FastAPI E-Commerce Core - Environment Variables Template (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this template to create your local environment file:
#    cp .env.example .env
# 2. .env is ignored by git (.gitignore). Never commit production secrets!
# ==============================================================================

# --- 1. Application & Meta Configuration ---
# Project display name in API documentation (OpenAPI / Swagger UI)
PROJECT_NAME="FastAPI E-Commerce Core"

# Debug mode (true: enables detailed error stack traces; false: production mode)
DEBUG=true

# API Semantic Versioning
API_VERSION="0.1.0"

# --- 2. Database Connection ---
# Async database connection URL
# Default: SQLite async via aiosqlite for local development and rapid testing
DATABASE_URL="sqlite+aiosqlite:///./ecommerce.db"

# PostgreSQL async example for production / staging environments:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ecommerce_db"

# Log raw SQL queries to console (true: inspect ORM operations; false: reduce logs)
DATABASE_ECHO=true

# --- 3. Security & Authentication (JWT) ---
# Secret key used for signing and verifying JWT tokens
# CRITICAL: In production, generate a secure random string (minimum 32 characters)!
SECRET_KEY="change-me-in-production-super-secret-key-at-least-32-chars"

# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- 4. Inventory & Cart Reservation ---
# Duration in minutes an item is held reserved in a user's cart before release
RESERVATION_TTL_MINUTES=15

# --- 5. Financial & US Localization Defaults ---
# Default ISO 4217 currency code (US Dollar standard)
DEFAULT_CURRENCY="USD"

# Default state / local sales tax percentage rate (e.g., 8.0 represents 8.0% US sales tax)
# Handled as Decimal in code to prevent floating-point calculation errors
TAX_RATE_PERCENT=8.0
